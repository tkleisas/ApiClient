<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApiClient.UI.Views.ConfirmWindow"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="72" Click="OnCancel"/>
            <Button Content="Delete" MinWidth="72" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
