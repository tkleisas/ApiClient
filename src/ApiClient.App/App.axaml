<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ApiClient.App.App"
             xmlns:local="using:ApiClient.App"
             xmlns:sys="using:System"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- Compact base font for controls; overridden at startup from saved settings. -->
        <sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaVirtualDataGrid/Themes/Generic.axaml" />

        <!-- Compact / dense layout: smaller control heights, tighter padding, smaller tab/menu text. -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="6,1"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="18"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="MinHeight" Value="20"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="18"/>
        </Style>
        <Style Selector="Menu">
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Application.Styles>
</Application>
