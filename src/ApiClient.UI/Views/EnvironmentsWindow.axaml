<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiClient.UI.ViewModels"
        x:Class="ApiClient.UI.Views.EnvironmentsWindow"
        x:CompileBindings="False"
        Title="Environments"
        Width="640" Height="460"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" MinWidth="80" Click="OnCancel"/>
            <Button Content="Save" MinWidth="80" Click="OnSave"/>
        </StackPanel>

        <Grid ColumnDefinitions="200,Auto,*">

            <!-- Environments list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="+ Add" Command="{Binding AddEnvironmentCommand}"/>
                    <Button Content="Remove" Command="{Binding RemoveEnvironmentCommand}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"/>

            <!-- Selected environment editor -->
            <DockPanel Grid.Column="2" IsVisible="{Binding SelectedEnvironment, Converter={x:Static ObjectConverters.IsNotNull}}"
                       DataContext="{Binding SelectedEnvironment}">
                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,8">
                    <TextBlock Text="Name"/>
                    <TextBox Text="{Binding Name}"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Content="+ Add variable" Command="{Binding AddVariableCommand}"/>
                <ItemsControl ItemsSource="{Binding Variables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,*,Auto" Margin="0,1">
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Enabled}"/>
                                <TextBox Grid.Column="1" Margin="4,0" PlaceholderText="Name" Text="{Binding Name}"/>
                                <TextBox Grid.Column="2" Margin="4,0" PlaceholderText="Value" Text="{Binding Value}"/>
                                <Button Grid.Column="3" Content="✕"
                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveVariableCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
