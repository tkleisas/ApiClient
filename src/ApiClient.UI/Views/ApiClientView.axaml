<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiClient.UI.ViewModels"
             xmlns:codegen="using:ApiClient.Core.CodeGen"
             xmlns:json="using:ApiClient.Core.Json"
             xmlns:conv="using:ApiClient.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="ApiClient.UI.Views.ApiClientView"
             x:DataType="vm:RequestEditorViewModel">

    <Design.DataContext>
        <vm:RequestEditorViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <conv:BoolToTextWrappingConverter x:Key="WordWrapConverter"/>
        <conv:JsonNodeKindToBrushConverter x:Key="JsonKindBrush"/>
    </UserControl.Resources>

    <DockPanel Margin="3">

        <!-- Request bar -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
            <ComboBox Grid.Column="0" Width="92"
                      ItemsSource="{Binding Methods}"
                      SelectedItem="{Binding Method}"/>
            <TextBox Grid.Column="1" Margin="3,0"
                     Text="{Binding Url}"
                     PlaceholderText="https://example.com/api"/>
            <Button Grid.Column="2" Width="72"
                    Content="Send"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding !IsSending}"
                    Command="{Binding SendCommand}"/>
        </Grid>

        <!-- Request config / response, vertically resizable -->
        <Grid RowDefinitions="2*,Auto,3*" Margin="0,3,0,0">

            <!-- Request configuration -->
            <TabControl Grid.Row="0">
                <TabItem Header="Headers">
                    <DockPanel Margin="2">
                        <Button DockPanel.Dock="Bottom" Content="+ Add header"
                                HorizontalAlignment="Left" Margin="0,3,0,0"
                                Command="{Binding AddHeaderCommand}"/>
                        <ItemsControl ItemsSource="{Binding Headers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Grid ColumnDefinitions="Auto,*,*,Auto" Margin="0,1">
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled}"/>
                                        <TextBox Grid.Column="1" Margin="4,0" PlaceholderText="Name"
                                                 Text="{Binding Name}"/>
                                        <TextBox Grid.Column="2" Margin="4,0" PlaceholderText="Value"
                                                 Text="{Binding Value}"/>
                                        <Button Grid.Column="3" Content="✕"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveHeaderCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Auth">
                    <StackPanel Margin="2" Spacing="6">
                        <ComboBox HorizontalAlignment="Left" Width="160"
                                  ItemsSource="{Binding AuthTypes}" SelectedItem="{Binding SelectedAuthType}"/>
                        <StackPanel IsVisible="{Binding IsBearerAuth}" Spacing="3">
                            <TextBlock Text="Token"/>
                            <TextBox Text="{Binding AuthToken}" TextWrapping="Wrap" AcceptsReturn="False"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsBasicAuth}" Spacing="3">
                            <TextBlock Text="Username"/>
                            <TextBox Text="{Binding AuthUsername}"/>
                            <TextBlock Text="Password"/>
                            <TextBox Text="{Binding AuthPassword}" PasswordChar="•"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsApiKeyAuth}" Spacing="3">
                            <TextBlock Text="Key name"/>
                            <TextBox Text="{Binding AuthKeyName}"/>
                            <TextBlock Text="Key value"/>
                            <TextBox Text="{Binding AuthKeyValue}"/>
                            <TextBlock Text="Add to"/>
                            <ComboBox HorizontalAlignment="Left" Width="160"
                                      ItemsSource="{Binding ApiKeyLocations}" SelectedItem="{Binding AuthKeyLocation}"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Body">
                    <DockPanel Margin="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Content-Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="220" Text="{Binding BodyMediaType}"/>
                        </StackPanel>
                        <TextBox AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 PlaceholderText="Request body (leave empty for none)"
                                 Text="{Binding RequestBody}"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Code">
                    <DockPanel Margin="2">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Generators}"
                                      SelectedItem="{Binding SelectedGenerator}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="codegen:ICodeGenerator">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Margin="6,0,0,0" Content="Generate"
                                    Command="{Binding GenerateCodeCommand}"/>
                        </Grid>
                        <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 Text="{Binding GeneratedCode}"/>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" Background="Transparent"/>

            <!-- Response -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Margin="0,2,0,3" FontWeight="SemiBold"
                           Text="{Binding ResponseSummary}"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="Response body">
                        <DockPanel Margin="2">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,3">
                                <ComboBox Width="96"
                                          ItemsSource="{Binding ResponseViews}"
                                          SelectedItem="{Binding SelectedResponseView}"/>
                                <CheckBox Content="Word wrap" VerticalAlignment="Center"
                                          IsChecked="{Binding WordWrap}"
                                          IsVisible="{Binding IsTextResponseView}"/>
                            </StackPanel>
                            <Panel>
                                <TextBox IsVisible="{Binding IsPrettyView}"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="{Binding WordWrap, Converter={StaticResource WordWrapConverter}}"
                                         FontFamily="Cascadia Code,Consolas,monospace"
                                         Text="{Binding ResponsePretty}"/>
                                <TextBox IsVisible="{Binding IsRawView}"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="{Binding WordWrap, Converter={StaticResource WordWrapConverter}}"
                                         FontFamily="Cascadia Code,Consolas,monospace"
                                         Text="{Binding ResponseBody}"/>
                                <TreeView IsVisible="{Binding IsTreeView}" ItemsSource="{Binding ResponseTree}">
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="json:JsonTreeNode">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="#4FC1FF"
                                                           FontFamily="Cascadia Code,Consolas,monospace"/>
                                                <TextBlock Text="{Binding Value}" Margin="8,0,0,0"
                                                           Foreground="{Binding Kind, Converter={StaticResource JsonKindBrush}}"
                                                           FontFamily="Cascadia Code,Consolas,monospace"/>
                                            </StackPanel>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Panel>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Response headers">
                        <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 Text="{Binding ResponseHeaders}"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
